rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPERS
    // ============================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isStoreOwner(storeId) {
      return isAuthenticated() 
        && request.auth.token.role == 'store'
        && request.auth.token.storeId == storeId;
    }

    function isDriver() {
      return isAuthenticated() && request.auth.token.role == 'driver';
    }

    function isOwnDriver(driverId) {
      return isAuthenticated() && request.auth.uid == driverId;
    }

    // ============================================
    // STORES
    // ============================================
    match /stores/{storeId} {
      // Leitura: próprio dono, admin, ou qualquer autenticado (para exibir nome no pedido)
      allow read: if isAdmin() || isStoreOwner(storeId);

      // Criação: somente admin
      allow create: if isAdmin();

      // Update: o próprio dono (SEM alterar balance/uid) ou admin
      allow update: if (isAdmin()) 
        || (isStoreOwner(storeId) 
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['balance', 'uid']));

      // Delete: somente admin
      allow delete: if isAdmin();
    }

    // ============================================
    // DRIVERS
    // ============================================
    match /drivers/{driverId} {
      allow read: if isAdmin()
        || isOwnDriver(driverId)
        || (isAuthenticated()
            && request.auth.token.role == 'store'
            && resource.data.activeStoreId == request.auth.token.storeId);

      // Criação: o próprio driver (auto-cadastro) ou admin
      allow create: if isOwnDriver(driverId) || isAdmin();

      // Update: 
      //   - o próprio driver pode alterar seus dados pessoais e status operacional
      //   - NÃO pode alterar: approved, blocked, blockReason, rating, totalDeliveries (campos de admin)
      allow update: if isAdmin() 
        || (isOwnDriver(driverId) 
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'approved', 'blocked', 'blockReason', 'rating', 'totalDeliveries',
              'acceptanceRate', 'cancellationRate', 'createdAt', 'activeStoreId'
            ]));

      allow delete: if isAdmin();
    }

    // ============================================
    // ORDERS
    // ============================================
    match /orders/{orderId} {
      // Leitura: 
      //   - admin
      //   - loja dona
      //   - motorista designado
      allow read: if isAuthenticated() && (
        isAdmin()
        || (resource.data.storeId != null 
            && isStoreOwner(resource.data.storeId))
        || (resource.data.assignedDriverId == request.auth.uid)
        // Motorista pode ver pedidos em oferta se estiver na lista (matching)
        || (resource.data.status == 'OFFERED' && resource.data.assignedDriverId == request.auth.uid)
      );

      // Criação: apenas via Cloud Function (admin SDK ignora rules)
      allow create: if false;

      // Update: motorista pode mudar apenas status operacionais específicos
      allow update: if isAdmin()
        || (isDriver() 
            && resource.data.assignedDriverId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'collectedAt', 'deliveredAt', 'deliveryProofUrl', 'statusHistory'])
            && isValidStatusTransition(resource.data.status, request.resource.data.status));

      allow delete: if isAdmin();
    }

    // Validação de transição de status
    function isValidStatusTransition(from, to) {
      let valid = {
        'ACCEPTED': ['ARRIVING_PICKUP', 'COLLECTED'],
        'ARRIVING_PICKUP': ['COLLECTED'],
        'COLLECTED': ['IN_DELIVERY', 'ARRIVING_DESTINATION', 'DELIVERED'],
        'IN_DELIVERY': ['ARRIVING_DESTINATION', 'DELIVERED'],
        'ARRIVING_DESTINATION': ['DELIVERED']
      };
      return to in valid[from];
    }

    // ============================================
    // TRANSACTIONS (imutáveis)
    // ============================================
    match /transactions/{transactionId} {
      // Leitura: admin ou loja dona da transação
      allow read: if isAdmin() 
        || (resource.data.storeId != null 
            && isStoreOwner(resource.data.storeId));

      // Escrita: somente Cloud Functions (Admin SDK)
      allow write: if false;
    }

    // ============================================
    // SETTINGS
    // ============================================
    match /settings/{docId} {
      // Pricing contains internal commission rules and is never exposed to stores/drivers.
      allow read: if isAdmin() || (isAuthenticated() && docId != 'pricing');
      allow write: if isAdmin();
    }

    match /driverEarnings/{earningId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.driverId == request.auth.uid);
      allow write: if false;
    }

    // ============================================
    // AUDIT LOG (append-only)
    // ============================================
    match /audit/{auditId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if false;
    }


    match /supportTickets/{ticketId} {
      allow read: if isAdmin()
        || (isAuthenticated() && (
          resource.data.createdBy == request.auth.uid
          || (resource.data.storeId != null && isStoreOwner(resource.data.storeId))
          || (resource.data.driverId == request.auth.uid)
        ));
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /supportMessages/{messageId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.participantIds != null && request.auth.uid in resource.data.participantIds);
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.recipientId == request.auth.uid);
      allow write: if false;
    }

    // ============================================
    // DEFAULT: deny all
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}