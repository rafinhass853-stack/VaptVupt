{
  "expo": {
    "name": "VaptVupt Motoboy",
    "slug": "vaptvupt-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "vaptvupt",
    "plugins": [
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-notifications"
    ],
    "splash": {
      "backgroundColor": "#111827",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O VaptVupt usa sua localização para mostrar sua posição no mapa e recalcular a rota da entrega.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "O VaptVupt usa sua localização em segundo plano durante entregas ativas para atualizar o mapa e o ETA."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#e30613"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
