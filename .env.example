# ============================================
# VaptVupt - Configurações de Ambiente
# Copie para .env.local e preencha os valores
# NUNCA commite o .env.local
# ============================================

# --- Firebase (Web SDK - pode ser público) ---
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=vaptvupt-ebe00.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vaptvupt-ebe00
VITE_FIREBASE_STORAGE_BUCKET=vaptvupt-ebe00.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
VITE_FUNCTIONS_REGION=us-central1

# --- Google Maps (server-side apenas - NUNCA exponha no frontend) ---
GOOGLE_MAPS_API_KEY=

# --- Firebase Admin SDK (apenas Cloud Functions) ---
# Em produção, use Application Default Credentials. Não commite service account keys.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Ambiente ---
NODE_ENV=development
APP_ENV=development